<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="TUGAS FLOWCHART LPP KEL 2 C"/>
        <attribute name="authors" value="Raisha Azzahra"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 10:53:04 AM"/>
        <attribute name="created" value="UmFpc2hhIEF6emFocmE7UkFJU0hBOzIwMjYtMDktMTc7MDg6NDc6MzcgQU07MzA3OA=="/>
        <attribute name="edited" value="UmFpc2hhIEF6emFocmE7UkFJU0hBOzIwMjYtMDktMTc7MTA6NTM6MDQgQU07MzszMTcy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pilihan, angka1, angka2, hasil" type="Integer" array="False" size=""/>
            <assign variable="pilihan" expression="0"/>
            <while expression="pilihan !=5">
                <output expression="&quot;1.Penjumlahan, 2. Pengurangan, 3. Perkalian, 4. Pembagian, 5. Keluar&quot;" newline="True"/>
                <input variable="pilihan"/>
                <if expression="pilihan == 1">
                    <then>
                        <input variable="angka1"/>
                        <input variable="angka2"/>
                        <assign variable="hasil" expression="angka1+angka2"/>
                        <output expression="&quot;Hasil: &quot; &amp; hasil" newline="True"/>
                    </then>
                    <else>
                        <if expression="pilihan == 2">
                            <then>
                                <input variable="angka1"/>
                                <input variable="angka2"/>
                                <assign variable="hasil" expression="angka1-angka2"/>
                                <output expression="&quot;Hasil: &quot; &amp; hasil" newline="True"/>
                            </then>
                            <else>
                                <if expression="pilihan == 3">
                                    <then>
                                        <input variable="angka1"/>
                                        <input variable="angka2"/>
                                        <assign variable="hasil" expression="angka1*angka2"/>
                                        <output expression="&quot;Hasil: &quot; &amp; hasil" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="pilihan == 4">
                                            <then>
                                                <input variable="angka1"/>
                                                <input variable="angka2"/>
                                                <assign variable="hasil" expression="angka1/angka2"/>
                                                <output expression="&quot;Hasil: &quot; &amp; hasil" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="pilihan == 5">
                                                    <then>
                                                        <output expression="&quot;Terima kasih&quot;" newline="True"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
